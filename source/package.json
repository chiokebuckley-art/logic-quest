{
  "name": "logic-quest",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "LOGIC QUEST - a logic game in the Engineering Quest family.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:single": "vite build -c vite.single.config.ts && node scripts/make-single-file.mjs",
    "pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  }
}
